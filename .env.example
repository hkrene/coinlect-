# Copy this file to .env.local and replace the placeholder values below.
# Do not commit real secrets or credentials to version control.

# PostgreSQL connection string for Prisma
DATABASE_URL=postgresql://username:password@localhost:5432/coinlect_db

# Strong secret used to sign JWT tokens
JWT_SECRET=replace-with-a-long-random-secret

# Public app base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth client ID used in the frontend
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google OAuth client ID used on the backend/server
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Gemini API key for AI chat features
GEMINI_API_KEY=your-gemini-api-key

# Cloudflare Turnstile (bot protection / CAPTCHA) — https://dash.cloudflare.com
# Leave blank to disable. Cloudflare's always-pass test keys (local dev only):
#   site key:   1x00000000000000000000AA
#   secret key: 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: CryptoCompare news API key for the market page.
# When set, /api/market/news uses CryptoCompare; otherwise it falls back to
# keyless RSS feeds (Cointelegraph/Decrypt/CoinDesk for EN, Cryptoast/Journal
# du Coin for FR).
CRYPTOCOMPARE_API_KEY=
