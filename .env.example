# Copy this file to .env.local and replace the placeholder values below.
# Do not commit real secrets or credentials to version control.

# PostgreSQL connection string for Prisma
DATABASE_URL=postgresql://username:password@localhost:5432/coinlect_db

# Strong secret used to sign JWT tokens
JWT_SECRET=replace-with-a-long-random-secret

# Public app base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth client ID used in the frontend
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google OAuth client ID used on the backend/server
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Gemini API key for AI chat features
GEMINI_API_KEY=your-gemini-api-key
